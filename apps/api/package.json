{
  "name": "@datarover/api",
  "version": "0.1.0",
  "private": true,
  "description": "DataRover HTTP API — persists projects/workflows/executions via Prisma and enqueues execution jobs via BullMQ. Never runs the workflow engine itself.",
  "scripts": {
    "build": "nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "@datarover/database": "workspace:*",
    "@datarover/queue": "workspace:*",
    "@datarover/workflow-types": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/node": "^20.14.0",
    "@swc/core": "^1.7.26",
    "dotenv-cli": "^11.0.0",
    "unplugin-swc": "^1.5.1"
  }
}
