generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExecutionStatus {
  pending
  running
  success
  failed
  cancelled
  retrying
}

enum ScheduleType {
  manual
  interval
  hourly
  daily
  weekly
  cron
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  variables   Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflows Workflow[]
}

model Workflow {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions   WorkflowVersion[]
  executions Execution[]
  schedules  Schedule[]

  @@index([projectId])
}

model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  version    Int
  definition Json
  createdAt  DateTime @default(now())

  workflow   Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions Execution[]

  @@unique([workflowId, version])
}

model Execution {
  id                String          @id @default(cuid())
  workflowId        String
  workflowVersionId String
  status            ExecutionStatus @default(pending)
  startedAt         DateTime?
  finishedAt        DateTime?
  error             String?
  actionResults     Json            @default("[]")
  createdAt         DateTime        @default(now())

  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  logs            ExecutionLog[]

  @@index([workflowId])
}

model ExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  timestamp   DateTime
  level       String
  message     String
  nodeId      String?

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

enum ProxyStatus {
  active
  disabled
}

/// One entry in the global, cross-project proxy pool (never scoped to a `Project` — the first
/// model in this schema that isn't). `errorCount`/`isInUse`/`reservedAt` are only ever mutated by
/// `@datarover/database`'s `proxyPool.ts` (atomic `FOR UPDATE SKIP LOCKED` reservation — a plain
/// `findFirst` + `update` from `apps/api`'s own CRUD would race two concurrent workflow
/// executions onto the same "available" proxy). `reservedAt` doubles as a staleness fallback: a
/// proxy reserved past a hardcoded window is treated as available again even if it was never
/// explicitly released (a worker process dying mid-execution, say) — deliberately no separate
/// cleanup job for this. Deleting a row here (the "purge" behavior once `errorCount` reaches
/// `ProxyPoolConfig.purgeErrorThreshold`) is a real `DELETE`, not a status flip — no history kept.
model Proxy {
  id         String      @id @default(cuid())
  host       String
  port       Int
  status     ProxyStatus @default(active)
  errorCount Int         @default(0)
  isInUse    Boolean     @default(false)
  reservedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([host, port])
  @@index([status, isInUse])
}

/// A single row (fixed id `"singleton"`, same fixed-id convention already used by `prisma/seed.ts`
/// for its own idempotent rows) — not a generic settings key/value table, since there's only one
/// value to configure so far. `apps/api`'s config endpoint upserts this defensively on first read,
/// in case the seed never ran.
model ProxyPoolConfig {
  id                  String   @id @default("singleton")
  purgeErrorThreshold Int      @default(5)
  updatedAt           DateTime @updatedAt
}

/// A recurring trigger for a workflow (Specs.md §14). `type: manual` and `enabled: false` both
/// mean "never fires automatically" — the difference is purely user intent (an explicit "no
/// schedule" choice vs. a temporarily paused one) — apps/api only ever registers a BullMQ job
/// scheduler (see @datarover/queue's SCHEDULE_TRIGGER_QUEUE_NAME) for a row that is both enabled
/// and not `manual`. `everyMinutes` is required (validated in apps/api's DTO, not here — Prisma
/// has no cross-field constraints) when `type` is `interval`; `cronExpression` when it is `cron`.
model Schedule {
  id             String       @id @default(cuid())
  workflowId     String
  type           ScheduleType
  everyMinutes   Int?
  cronExpression String?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}
