# Copy to .env and adjust as needed. Never commit the real .env file.

# --- PostgreSQL (docker-compose.yml "postgres" service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datarover
POSTGRES_USER=datarover
POSTGRES_PASSWORD=datarover

# Full connection string used by Prisma (packages/database). Must stay consistent with the
# POSTGRES_* values above.
DATABASE_URL=postgresql://datarover:datarover@localhost:5432/datarover?schema=public

# --- Redis (docker-compose.yml "redis" service) — used by BullMQ (apps/api producer, apps/worker consumer) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- apps/api ---
API_PORT=3001
# Origin allowed to call the API from a browser (apps/web's dev server).
WEB_ORIGIN=http://localhost:5173

# --- apps/worker ---
# Number of workflow executions this worker process runs concurrently.
WORKER_CONCURRENCY=5

# --- apps/browser-worker --- (Specs.md §19-20: browser rendering, isolated from apps/api/apps/worker)
BROWSER_WORKER_PORT=3002
# Where apps/api reaches it. Plain local dev (both on the host): localhost. Inside Docker: the
# service's own name on the compose network (docker-compose.yml sets this to http://browser-worker:3002).
BROWSER_WORKER_URL=http://localhost:3002
# Only needed if playwright-core can't find a browser at one of its own default candidate paths
# (see apps/browser-worker/src/render/chromeBinary.ts) — e.g. a non-standard Chromium install path.
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# --- apps/web ---
WEB_PORT=5173
# Base URL the web app uses to reach apps/api.
VITE_API_URL=http://localhost:3001

NODE_ENV=development
