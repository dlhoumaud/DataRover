{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "11",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "POSTGRES_HOST",
    "POSTGRES_PORT",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "API_PORT",
    "WEB_PORT",
    "WEB_ORIGIN",
    "WORKER_CONCURRENCY",
    "BROWSER_WORKER_PORT",
    "BROWSER_WORKER_URL",
    "CHROME_EXECUTABLE_PATH",
    "NODE_ENV",
    "VITE_API_URL",
    "E2E_WEB_URL",
    "E2E_API_URL",
    "FIREFOX_BIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
