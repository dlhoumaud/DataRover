{
  "name": "datarover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataRover — Explore the web. Capture the data.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @datarover/database run generate",
    "db:migrate": "pnpm --filter @datarover/database run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @datarover/database run migrate:deploy",
    "db:studio": "pnpm --filter @datarover/database run studio",
    "db:seed": "pnpm --filter @datarover/database run seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
