# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/
.claude/

# Testing
coverage/

# Stray compiled siblings that can appear under a test/ directory: a non-*.test.ts helper file
# living outside an app's `src/` (tsconfig's rootDir) can get swept into a running dev
# container's incremental build (nest start --watch) and emitted right next to its own .ts
# source instead of into dist/ — harmless (safe to delete), but should never be committed.
apps/*/test/**/*.js
apps/*/test/**/*.js.map

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Electron / Playwright (future)
out/
release/
playwright-report/
test-results/
